{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MisterIcy/bleedthrough/schemas/bench-result.schema.json",
  "title": "Benchmark result, schema version 1",
  "description": "One document per run. A stage that cannot run is `unavailable` with a reason, never omitted and never zero. Contains no secrets and no absolute paths.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1" },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      },
      "required": ["name", "version", "commit"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "cpu_model": { "type": "string" },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "profile": { "enum": ["release", "debug"] }
      },
      "required": ["os", "cpu_model", "logical_cores", "profile"],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "`synthetic:<parameters>` or `real:<project id>`.",
        "properties": {
          "name": { "type": "string", "pattern": "^(synthetic|real):" },
          "files": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "required": ["name", "files", "bytes"],
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "input": { "type": "string" },
              "status": { "const": "measured" },
              "iterations": { "type": "integer", "minimum": 5 },
              "warmups": { "type": "integer", "minimum": 0 },
              "samples_ns": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 5 },
              "median_ns": { "type": "integer", "minimum": 0 },
              "spread_ns": { "type": "integer", "minimum": 0 },
              "min_ns": { "type": "integer", "minimum": 0 },
              "files_per_sec": { "type": "integer", "minimum": 0 },
              "bytes_per_sec": { "type": "integer", "minimum": 0 },
              "peak_rss_kb": { "type": ["integer", "null"], "description": "null where the platform does not expose it." },
              "counters": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
              "allocation": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "properties": {
                      "count": { "type": "integer", "minimum": 0 },
                      "total_bytes": { "type": "integer", "minimum": 0 },
                      "peak_bytes": { "type": "integer", "minimum": 0 }
                    },
                    "required": ["count", "total_bytes", "peak_bytes"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": ["stage", "input", "status", "iterations", "warmups", "samples_ns", "median_ns", "spread_ns", "min_ns", "files_per_sec", "bytes_per_sec", "peak_rss_kb", "counters", "allocation"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "input": { "type": "string" },
              "status": { "const": "unavailable" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["stage", "input", "status", "reason"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["schema_version", "tool", "environment", "inputs", "stages"],
  "additionalProperties": false
}
